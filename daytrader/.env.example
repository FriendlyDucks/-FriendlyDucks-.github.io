# Kopiera till .env och fyll i. .env checkas aldrig in i git.

# --- AI-motor ---
# ollama      = lokal gratismodell (installera https://ollama.com, kör: ollama pull qwen2.5:14b)
# claude-code = din Claude Pro/Max-prenumeration via det lokala `claude`-kommandot
# api         = Anthropic API (kostar krediter, kräver ANTHROPIC_API_KEY)
LLM_BACKEND=ollama
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_URL=http://localhost:11434

# Claude-modell för claude-code och api
CLAUDE_MODEL=claude-opus-5-5
# Bara för api: skapa nyckel på https://platform.claude.com -> API Keys
ANTHROPIC_API_KEY=

# --- Kursdata (minst en) ---
# Twelve Data (twelvedata.com): realtid för Stockholmsbörsen kräver Pro-planen.
#   Gratisnyckeln fungerar med testaktien INVE B.
TWELVEDATA_API_KEY=
# EODHD (eodhd.com): Stockholmsaktier med ~15 min fördröjning, ingår i "All World Extended".
EODHD_API_KEY=

# --- Webbsidan ---
# Krävs om du startar med --host 0.0.0.0 för att nå sidan från mobilen
DASHBOARD_TOKEN=

# --- Nordnet API (tar inte in nya kunder just nu) ---
# 1. ssh-keygen -t ed25519 -f ~/.ssh/nordnet_ed25519 -N ""
# 2. Ladda upp ~/.ssh/nordnet_ed25519.pub på nordnet.se: Mina sidor -> Inställningar -> Min profil -> Säkerhet
# 3. Kopiera API-nyckeln (UUID) som visas där
NORDNET_API_KEY=
NORDNET_PRIVATE_KEY=~/.ssh/nordnet_ed25519
NORDNET_COUNTRY=se
# Valfritt: konto-id (accid). Tomt = ditt förvalda konto.
NORDNET_ACCID=

# Måste vara exakt JA för att --live ska skicka riktiga order
NORDNET_LIVE_CONFIRM=NEJ
